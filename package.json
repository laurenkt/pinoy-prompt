{
  "name": "pinoy-prompt",
  "private": true,
  "version": "0.1.0",
  "description": "A beginner-friendly PWA for learning Tagalog with spaced repetition.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
