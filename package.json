    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/generate-audio.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "about-shots": "node scripts/about-shots.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.14.6",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "onnxruntime-web": "^1.22.0"
  }
}
